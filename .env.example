# Hyperactive Amateur environment variables
# Copy to .env.local and fill in real values.

# Google AI Studio API key for Gemini.
# Powers auto-tagging clips, "Suggest a beat", and the variation buttons.
# Get a key at https://aistudio.google.com/app/apikey
#
# Local dev: read by the Vite dev middleware in vite.config.ts. Never
# reaches the client bundle.
# Production (Vercel): set the same name as a Project Environment Variable
# in the Vercel dashboard, scoped to Production + Preview. Read by
# api/gemini.ts at request time.
GEMINI_API_KEY=

# Production Gemini proxy allowlist. Comma-separated origins, no paths.
# Include the public/custom production domain. Vercel deployment URLs are
# also detected from VERCEL_PROJECT_PRODUCTION_URL, VERCEL_BRANCH_URL, and
# VERCEL_URL when those platform variables are present.
GEMINI_ALLOWED_ORIGINS=https://your-domain.example

# Production rate limiting is fail-closed. Set either the Upstash names below
# or Vercel KV's KV_REST_API_URL / KV_REST_API_TOKEN aliases in Vercel.
# The REST URL must be HTTPS in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional separate HMAC secret for short-lived Gemini proxy request tokens.
# When unset, GEMINI_API_KEY is used as the signing secret.
GEMINI_REQUEST_TOKEN_SECRET=
GEMINI_REQUEST_TOKEN_TTL_SECONDS=120

# Optional Gemini proxy rate-limit tuning.
# Defaults: 60 requests per 10 minutes per route bucket, allowed origin,
# and Vercel client IP.
GEMINI_RATE_LIMIT_MAX=60
GEMINI_RATE_LIMIT_WINDOW_SECONDS=600
