# Hyperactive Amateur environment variables
# Copy to .env.local and fill in real values.

# Google AI Studio API key for Gemini.
# Powers auto-tagging clips, "Suggest a beat", and the variation buttons.
# Get a key at https://aistudio.google.com/app/apikey
#
# Local dev: read by the Vite dev middleware in vite.config.ts. Never
# reaches the client bundle.
# Production (Vercel): set the same name as a Project Environment Variable
# in the Vercel dashboard, scoped to Production + Preview. Read by
# api/gemini.ts at request time.
GEMINI_API_KEY=
